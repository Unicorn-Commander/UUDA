<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>tech.magicunicorn.uc-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/uc-agent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>UC_AGENT_CONFIG</key>
        <string>/etc/uc-agent/config.toml</string>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    <key>StandardErrorPath</key>
    <string>/var/log/uc-agent.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/uc-agent.log</string>
    <key>WorkingDirectory</key>
    <string>/var/lib/uc-agent</string>
    <key>UserName</key>
    <string>root</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
